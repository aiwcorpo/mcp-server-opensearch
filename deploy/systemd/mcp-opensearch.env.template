# Environment of the mcp-opensearch service: copy to /etc/mcp-opensearch/mcp-opensearch.env (root:mcp, 0640).
# The real file is never committed. Prefer rendering it from the secrets store at deploy time.
# No backend credential here: the gateway sends the user's credential with every call (C3).

# mTLS: this server's certificate (CN mcp-opensearch, SAN mcp-opensearch.internal, server and client use) and the internal CA, both PKCS12.
MCP_TLS_KEYSTORE=/etc/mcp-opensearch/tls/keystore.p12
MCP_TLS_TRUSTSTORE=/etc/mcp-opensearch/tls/truststore.p12
MCP_TLS_STORE_PASSWORD=

# Gateway: JWKS of the internal JWT (C2), served over TLS signed by the internal CA.
MCP_GATEWAY_JWKS_URI=https://mcp-gateway.internal:8443/.well-known/jwks.json

# Portal page for connecting an account, sent in credential_required; {system} is replaced by the server.
# Format: https://<portal>/connections?system={system}
MCP_CONNECT_URL=

# Policy data (scope mapping, allowed AI clients, emergency overrides) of the gateway, fetched over mTLS with this server's
# own certificate (the gateway reads the server id from its CN). The policies themselves are in the jar.
MCP_GATEWAY_POLICY_DATA_URL=https://mcp-gateway.internal:8443/internal/v1/policy-data
# Only when the host in the URL is not a name in the gateway certificate:
# MCP_GATEWAY_TLS_NAME=mcp-gateway.internal

# This server as the registry sees it (GET /mcp-manifest); the gateway has its own configured address.
MCP_INTERNAL_URL=https://mcp-opensearch.internal:8443/mcp

# OpenSearch REST API; MCP_OPENSEARCH_SSL_BUNDLE only when it needs a non-default trust store.
MCP_OPENSEARCH_URL=

# Index prefixes the server may touch at all, comma-separated (prefix p covers p and p-*). Required.
MCP_OPENSEARCH_INDEX_PREFIXES=
# Optional, defaults in application.yml: time field, searched fields, returned fields, longest time range.
#MCP_OPENSEARCH_TIMESTAMP_FIELD=@timestamp
#MCP_OPENSEARCH_QUERY_FIELDS=message
#MCP_OPENSEARCH_RESULT_FIELDS=@timestamp,message,log.level,service.name,host.name
#MCP_OPENSEARCH_MAX_RANGE=7d
# Paging of search_logs: a field with a different value in every document (keyword or number), not _id. Empty = no paging.
#MCP_OPENSEARCH_TIEBREAKER_FIELD=event.id
# GET / of the cluster is read at startup, anonymously, to learn the version. A cluster with the Security plugin refuses
# it; then the server runs in degraded mode (see get_backend_info). true = the cluster is OpenSearch 2.x or 3.x and the
# server runs with the full feature set.
#MCP_OPENSEARCH_ASSUME_TESTED_VERSION=false

# Key of the cursors of search_logs and list_indices: Base64 of at least 32 random bytes, the same on every instance
# (openssl rand -base64 32). Without it each instance draws its own and logs a warning.
MCP_CURSOR_KEY=

# Redis for one-time jti (ACL user mcp-opensearch, keys jti:mcp-opensearch:*, command SET).
MCP_REDIS_HOST=
MCP_REDIS_PORT=6379
MCP_REDIS_USER=mcp-opensearch
MCP_REDIS_PASSWORD=
