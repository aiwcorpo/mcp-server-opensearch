# systemd unit: /etc/systemd/system/mcp-opensearch.service
#   systemctl daemon-reload && systemctl enable --now mcp-opensearch
[Unit]
Description=MCP server mcp-opensearch (behind the MCP gateway, mTLS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp
Group=mcp
# Secrets and addresses (mcp-opensearch.env.template); logs go to journald.
EnvironmentFile=/etc/mcp-opensearch/mcp-opensearch.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -jar /opt/mcp-opensearch/mcp-opensearch.jar

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# The JIT needs writable and executable memory.
MemoryDenyWriteExecute=false
ReadOnlyPaths=/etc/mcp-opensearch /opt/mcp-opensearch
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
