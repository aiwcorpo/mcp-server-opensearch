# Configuration of mcp-opensearch. Fill in the empty values.
# No backend credential here: the gateway sends the user's own token (token exchange) with every call.

# Password of certs/keystore.p12 and certs/truststore.p12 (one password for both).
MCP_TLS_STORE_PASSWORD=

# Gateway: JWKS of the internal JWT and the policy data (scope mapping, allowed AI clients, emergency overrides). Both are
# fetched over TLS of the internal CA; the policy data with this server's own certificate.
MCP_GATEWAY_JWKS_URI=https://mcp-gateway.internal:8443/.well-known/jwks.json
MCP_GATEWAY_POLICY_DATA_URL=https://mcp-gateway.internal:8443/internal/v1/policy-data
# Only when the host in the URLs above is not a name in the gateway certificate:
# MCP_GATEWAY_TLS_NAME=mcp-gateway.internal

# Portal page for connecting an account, sent in credential_required; {system} is replaced by the server.
# Format: https://<portal>/connections?system={system}
MCP_CONNECT_URL=

# Key of the cursors of search_logs and list_indices: Base64 of at least 32 random bytes, the same on every instance
# (openssl rand -base64 32).
MCP_CURSOR_KEY=

# OpenSearch REST API; MCP_OPENSEARCH_SSL_BUNDLE only when it needs a non-default trust store.
MCP_OPENSEARCH_URL=

# Index prefixes the server may touch at all, comma-separated (prefix p covers p and p-*). Required.
MCP_OPENSEARCH_INDEX_PREFIXES=

# GET / of the cluster is read at startup, anonymously. A cluster with the Security plugin refuses it and the server runs in
# degraded mode; true = the cluster is OpenSearch 2.x or 3.x and the server runs with the full feature set.
MCP_OPENSEARCH_ASSUME_TESTED_VERSION=false

# Redis for the one-time jti, started by compose.yaml next to the server (ACL user mcp-opensearch, keys jti:mcp-opensearch:*, command SET).
# Choose the password (openssl rand -hex 24); compose.yaml sets MCP_REDIS_HOST.
MCP_REDIS_HOST=
MCP_REDIS_PORT=6379
MCP_REDIS_USER=mcp-opensearch
MCP_REDIS_PASSWORD=

# The address the gateway reaches this server at, for the manifest (informative; the gateway has its own entry).
MCP_INTERNAL_URL=https://mcp-opensearch.internal:8443/mcp
