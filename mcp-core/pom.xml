<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-core: domain and ports. No Spring beans and no MCP transport here, so business rules stay testable
  without them; the starter is a dependency only for the shared result type UntrustedText.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pl.aiwcorpo.mcp.opensearch</groupId>
        <artifactId>mcp-opensearch-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>mcp-core</artifactId>
    <dependencies>
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-platform-starter</artifactId>
        </dependency>
    </dependencies>
    <name>mcp-opensearch :: Core (domain + ports)</name>
</project>
